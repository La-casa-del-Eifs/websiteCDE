# ─────────────────────────────────────────────────────────────
# Configuración de Supabase
# Copia este archivo como ".env.local" y rellena con tus valores.
# Los encuentras en: Supabase > Project Settings > API
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL del sitio (para enlaces de confirmación de correo, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Pagos y pedidos (checkout)
# ─────────────────────────────────────────────────────────────
# Service role de Supabase (SECRETO, solo servidor) — permite crear pedidos
# como invitado. NO lleva NEXT_PUBLIC. Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Webpay / Transbank. Por defecto usa integración (pruebas), no necesitas nada.
TBK_ENVIRONMENT=integration
# Para producción (cobros reales), completa con tus credenciales de Transbank:
# TBK_ENVIRONMENT=production
# TBK_COMMERCE_CODE=
# TBK_API_KEY=

# ─────────────────────────────────────────────────────────────
# Bsale (SECRETO, solo servidor) — productos, stock, clientes, facturación
# Token de pruebas: https://account.bsale.dev/users/create
BSALE_ACCESS_TOKEN=
# Opcional: URL base (por defecto https://api.bsale.io/v1)
# BSALE_API_URL=https://api.bsale.io/v1
# Opcional: lista de precios a usar (por defecto la primera activa)
# BSALE_PRICE_LIST_ID=
# Facturación Bsale: id del tipo de documento (ej. Boleta electrónica) y sucursal.
# El id lo ves en Panel > Bsale > Probar conexión (documentTypes).
BSALE_DOCUMENT_TYPE_ID=
# Id del tipo Factura electrónica (codeSii 33), para emitir facturas
BSALE_FACTURA_TYPE_ID=
BSALE_OFFICE_ID=1
